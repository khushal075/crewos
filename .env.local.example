# Copy to .env.local and replace the token. Never commit live credentials.
TENANT_API_KEYS={"1":"replace-with-a-long-random-token"}
# No tool permissions by default. Opt in deliberately, e.g. {"1":["agent_task.read"]}
TENANT_PERMISSIONS={}
TENANT_ID=1
CELERY_QUEUE_NAME=crewai
CELERY_CONCURRENCY=2
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1
# Per socket connect/read timeout; not a total tool deadline.
REDIS_OPERATION_TIMEOUT=2
# With Compose --profile local-model: docker compose exec ollama ollama pull llama3
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3
API_KEY=
LOGGING_LEVEL=INFO

# Durable agent records: API and workers must share this single-host file.
AGENT_RUN_DB_PATH=var/agent_runs.sqlite3
AGENT_LEASE_SECONDS=45
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_DURATION=120
AGENT_MAX_DECISIONS=20
AGENT_MAX_TOKENS=100000
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_MAX_RECOVERIES=1
# Optional estimated cost admission: configure all three explicitly for your provider.
# AGENT_MAX_COST_USD=0.25
# AGENT_INPUT_USD_PER_MILLION=YOUR_CONFIGURED_INPUT_RATE
# AGENT_OUTPUT_USD_PER_MILLION=YOUR_CONFIGURED_OUTPUT_RATE

# Document lifecycle API and worker share this dedicated local SQLite file.
DOCUMENT_DB_PATH=var/documents.sqlite3
DOCUMENT_JOB_LEASE_SECONDS=180
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_MAX_REQUEST_BYTES=8100000
# Grant explicitly as needed through TENANT_PERMISSIONS; no grants are automatic:
# document.create, document.update, document.read, document.delete,
# document.job.read, document.job.retry (retry also requires the original write permission).
