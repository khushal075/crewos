# Copy to .env.local and replace the token. Never commit live credentials.
TENANT_API_KEYS={"1":"replace-with-a-long-random-token"}
# No tool permissions by default. Opt in deliberately, e.g. {"1":["agent_task.read"]}
TENANT_PERMISSIONS={}
TENANT_ID=1
CELERY_QUEUE_NAME=crewai
CELERY_CONCURRENCY=2
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1
# Per socket connect/read timeout; not a total tool deadline.
REDIS_OPERATION_TIMEOUT=2
# With Compose --profile local-model: docker compose exec ollama ollama pull llama3
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3
API_KEY=
LOGGING_LEVEL=INFO

# Durable agent records: API and workers must share this single-host file.
AGENT_RUN_DB_PATH=var/agent_runs.sqlite3
AGENT_LEASE_SECONDS=45
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_DURATION=120
AGENT_MAX_DECISIONS=20
AGENT_MAX_TOKENS=100000
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_MAX_RECOVERIES=1
# Optional estimated cost admission: configure all three explicitly for your provider.
# AGENT_MAX_COST_USD=0.25
# AGENT_INPUT_USD_PER_MILLION=YOUR_CONFIGURED_INPUT_RATE
# AGENT_OUTPUT_USD_PER_MILLION=YOUR_CONFIGURED_OUTPUT_RATE

# Document lifecycle API and worker share this dedicated local SQLite file.
DOCUMENT_DB_PATH=var/documents.sqlite3
# Optional: installed model on the configured endpoint for document-answer reviews.
# Leave unset to reuse LLM_MODEL; calibrate before choosing a reviewer.
# DOCUMENT_REVIEW_MODEL=your-installed-reviewer-model
DOCUMENT_JOB_LEASE_SECONDS=180
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_MAX_REQUEST_BYTES=8100000
# Grant explicitly as needed through TENANT_PERMISSIONS; no grants are automatic:
# document.create, document.update, document.read, document.delete,
# document.job.read, document.job.retry (retry also requires the original write permission).

# Native Ollama embedding API; not the chat /v1 endpoint. No automatic downloads.
EMBEDDING_BASE_URL=http://localhost:11434
# Set all three after installing/inspecting a dedicated embedding model.
# EMBEDDING_MODEL=your-installed-embedding-model:tag
# Expected full 64-character lowercase digest from /api/tags; checked before/after inference.
# EMBEDDING_MODEL_REVISION=installed-model-digest
# EMBEDDING_DIMENSIONS=verified-output-dimensions
EMBEDDING_TIMEOUT=30

# Opt-in vector or hybrid retrieval. BM25 remains the default.
# Set RETRIEVAL_STRATEGY=hybrid to fuse BM25 and vector rankings.
RETRIEVAL_STRATEGY=bm25
HYBRID_CANDIDATE_K=20
HYBRID_RRF_RANK_CONSTANT=60
EMBEDDING_DB_PATH=var/embeddings.sqlite3
# For nomic-embed-text:v1.5, explicitly set these task prefixes:
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_QUERY_PREFIX="search_query: "
VECTOR_MAX_CHUNKS=512
VECTOR_MAX_EMBEDDING_BYTES=32000000
VECTOR_MAX_INPUT_BYTES=262144

# Internal cleanup poller: explicit tenant allowlist; no scope enabled by default.
# Example: DOCUMENT_CLEANUP_TENANTS=["tenant_a"]
DOCUMENT_CLEANUP_TENANTS=[]
DOCUMENT_CLEANUP_LEASE_SECONDS=30
DOCUMENT_CLEANUP_RETRY_BASE_SECONDS=10
DOCUMENT_CLEANUP_RETRY_MAX_SECONDS=300
DOCUMENT_CLEANUP_POLL_SECONDS=2
DOCUMENT_CLEANUP_BATCH_SIZE=20
DOCUMENT_CLEANUP_ALERT_AFTER_ATTEMPTS=5

# Indexed keyword retrieval: RETRIEVAL_STRATEGY=indexed_bm25 (transactional SQLite FTS5).
# Optional second-stage model scoring; disabled by default, requires explicit model.
RERANKING_ENABLED=false
# RERANKING_MODEL=your-installed-chat-model
RERANKING_CANDIDATE_K=20

# Read-only webhook service adapter. No tool or grants enabled by default.
WEBHOOK_INTEGRATION_ENABLED=false
WEBHOOK_HTTP_CONNECTIONS={}
# Supply tenant-scoped credentials through your deployment secret mechanism.
# HTTP contract: GET /v1/tenants/{tenant_id}/deliveries/{delivery_id}
# Example shape (placeholder token): {"tenant_a":{"base_url":"https://webhooks.example.com","token":"replace-me"}}
# Grant webhook_delivery.read separately in TENANT_PERMISSIONS when appropriate.
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RESPONSE_BYTES=16384

# Opt-in local MCP transport for the same read-only tool. Takes precedence over
# HTTP when enabled; failure never falls back. See docs/architecture/mcp-integration.md.
MCP_WEBHOOK_ENABLED=false
MCP_WEBHOOK_SERVERS={"servers":[]}

# Human review and offline feedback. Disabled unless explicitly enabled.
AGENT_ACTIONS_ENABLED=false
AGENT_ACTION_DB_PATH=var/agent_actions.sqlite3
AGENT_ACTION_APPROVAL_TTL=900
AGENT_REVIEWER_KEYS={}
AGENT_FEEDBACK_ENABLED=false
AGENT_FEEDBACK_DB_PATH=var/agent_feedback.sqlite3

# Optional model decision failover. Provision real credentials outside this file.
# AGENT_FALLBACK_MODEL={"base_url":"https://provider.example/v1","model":"secondary","api_key":"replace-me","primary_timeout_seconds":10}

# Optional Prometheus scrape bearer token. Without a token /metrics is disabled.
# AGENT_METRICS_TOKEN=replace-me
